# ==========================================
# Rai Backend - Environment Variables Template
# ==========================================

# --- Core Django Settings ---
SECRET_KEY=your-super-secret-django-key-here
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
SERVER_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL / SQLite) ---
# For development with SQLite, leave DATABASE_URL empty.
# For PostgreSQL / Docker:
DATABASE_URL=postgresql://postgres:password@localhost:5432/Rai_Backend
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=Rai_Backend
DB_CONN_MAX_AGE=60

# --- Security, CORS & CSRF ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REQUIRE_SSL=False

# --- Redis, Channels & Caching ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=rai

# --- Celery Configuration ---
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_PREFETCH_MULTIPLIER=1
CELERY_BROKER_POOL_LIMIT=10
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# --- AI & External APIs ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
THE_ODDS_API_KEY=your-the-odds-api-key-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Email & SMS (Infobip / SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=noreply@rai.app

INFOBIP_BASE_URL=https://your-infobip-domain.api.infobip.com
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_SENDER_ID=your-sender-id

# --- Push Notifications (Firebase) ---
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# --- JWT Authentication ---
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=7

# --- Rate Limiting & Throttling ---
PAGE_SIZE=20
THROTTLE_ANON=200/minute
THROTTLE_USER=1000/day
THROTTLE_OTP=5/minute
THROTTLE_LOGIN=10/minute
THROTTLE_MEDIA=2000/hour
THROTTLE_CONVERSATION=100/hour
THROTTLE_COMMUNITY=100/hour

# --- AWS S3 Storage (Optional, for Production) ---
USE_AWS=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Swagger / API Docs Basic Auth ---
DOCS_USERNAME=Admin
DOCS_PASSWORD=password
LOG_LEVEL=INFO